<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Só HTTPS; só certificados raiz do sistema (ignora CAs instaladas pelo usuário/malware) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
